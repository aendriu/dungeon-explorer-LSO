// Esempio di risposta JSON che il server manda al client
// Costruito da build_game_state_json() in server/src/game_state.c
{
    "map_size": 10,
    "player_id": 0,
    "current_room": 2,
    // Possibili valori di "error":
    //   null             → nessun errore
    //   "TEAM_DEFEATED"  → il team ha perso tutte le vite
    //   "TEAM_WON"       → raccolti tutti e 3 i quest items
    //   "BOOBY_TRAP"     → il player ha calpestato una trappola esplosiva
    //   "QUEST_UPDATE"   → raccolto un quest item
    //   "ITEM_MISSED"    → item gia' raccolto da un altro player
    //   "LIFE_LOST"      → il team ha perso una vita (mostro/trappola)
    //   "APPLE_HEAL"     → raccolto una mela, +1 vita al team
    //   "INVALID_PLAYER"       → player_id non valido
    //   "MISSING_POS"          → coordinate mancanti nella richiesta
    //   "INVALID_POS"          → coordinate fuori dai limiti della stanza
    //   "MISSING_TARGET"       → stanza target mancante nella richiesta
    //   "INVALID_CURRENT_ROOM" → stanza corrente non valida
    //   "INVALID_TARGET"       → stanza target fuori range
    //   "INVALID_MOVE"         → nessun corridoio tra le due stanze
    "error": null,

    // Stanza corrente di ogni player (max 4). -1 = non connesso
    "players": [2, 0, -1, -1],

    // Coordinate [y, x] di ogni player nella propria stanza. -1 = assente
    "pos": [
        [8, 12],
        [10, 15],
        [-1, -1],
        [-1, -1]
    ],

    // Matrice di adiacenza 10x10 (corridoi tra stanze). 1 = collegamento
